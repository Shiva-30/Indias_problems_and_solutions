---
import Base from '../layouts/Base.astro';
---
<Base title="Search">
  <div class="stack">
    <div class="detail-head"><h1>Search</h1></div>
    <div id="search"></div>
    <noscript>Search needs JavaScript.</noscript>
  </div>
</Base>

<!-- Pagefind builds its search index after `astro build`, so search works on the built site, not in `npm run dev`. -->
<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (!window.PagefindUI) {
      document.getElementById('search').textContent = 'Search is available on the built site (npm run build, then npm run preview).';
      return;
    }
    const ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
    const q = new URLSearchParams(location.search).get('q');
    if (q) ui.triggerSearch(q);
  });
</script>

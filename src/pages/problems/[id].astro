---
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CategoryTags from '../../components/CategoryTags.astro';
import SolutionCard from '../../components/SolutionCard.astro';
import ProblemCard from '../../components/ProblemCard.astro';
import ResourceSection from '../../components/ResourceSection.astro';
import TakeAction from '../../components/TakeAction.astro';
import Chart from '../../components/Chart.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { resourcesFor, type Problem } from '../../lib/data';

export async function getStaticPaths() {
  const problems = await getCollection('problems');
  return problems.map((problem) => ({ params: { id: problem.id }, props: { problem } }));
}

const { problem } = Astro.props as { problem: Problem };
const { title, summary, summarySources, categories, sdgs, keyStats, charts, regionNote, whatYouCanDo, whatGovernmentCanDo } = problem.data;
const { Content } = await render(problem);
const regions = await getEntries(problem.data.regions);
// Problems list their solutions, and solutions list their problems. Show both directions.
const solutions = (await getCollection('solutions')).filter(
  (s) => problem.data.solutions.some((r) => r.id === s.id) || s.data.problems.some((r) => r.id === problem.id),
);
const resources = await resourcesFor(problem);
// Related problems: links written on either page, or else up to 3 from the same categories.
const allProblems = (await getCollection('problems')).filter((p) => p.id !== problem.id);
const linked = allProblems.filter(
  (p) => problem.data.related.some((r) => r.id === p.id) || p.data.related.some((r) => r.id === problem.id),
);
const catIds = new Set(categories.map((c) => c.id));
const related = linked.length
  ? linked
  : allProblems.filter((p) => p.data.categories.some((c) => catIds.has(c.id))).slice(0, 3);
---
<Base title={title} description={summary}>
  <div class="stack">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/problems/">Problems</a><span>/</span><span>{title}</span></nav>
    <header class={`page-hero c-${categories[0].id}`}>
      <div class="detail-head">
        <CategoryTags kind="problem" categories={categories} sdgs={sdgs} />
        <h1>{title}</h1>
        <p class="summary">{summary}</p>
        {summarySources.length > 0 && (
          <p class="cite">Source{summarySources.length > 1 && 's'}: {summarySources.map((s, i) => <>{i > 0 && ', '}<a href={s.url} target="_blank" rel="noopener">{s.source}</a></>)}</p>
        )}
        <p class="where">
          Where: {regions.map((r, i) => <>{i > 0 && ', '}<a href={`/regions/${r.id}/`}>{r.data.name}</a></>)}
          {regionNote && <> · {regionNote}</>}
        </p>
        {whatYouCanDo.length > 0 && <a class="jump" href="#take-action">What can I do?</a>}
      </div>
      <div class="hero-art"><CategoryIcon category={categories[0].id} size={72} /></div>
    </header>

    {(keyStats.length > 0 || charts.length > 0) && (
      <section class={`c-${categories[0].id}`} aria-label="In numbers">
        <div class="section-head"><h2>In numbers</h2></div>
        <div class="stack" style="gap:16px">
          {keyStats.length > 0 && (
            <div class="stats">
              {keyStats.map((s) => (
                <div class="stat">
                  <b>{s.value}</b><span>{s.label}</span>
                  <small>Source: {s.sourceUrl ? <a href={s.sourceUrl} target="_blank" rel="noopener">{s.source}</a> : s.source}</small>
                </div>
              ))}
            </div>
          )}
          {charts.length > 0 && <div class="charts">{charts.map((c) => <Chart {...c} />)}</div>}
        </div>
      </section>
    )}

    <section class="prose"><Content /></section>

    <TakeAction id={problem.id} you={whatYouCanDo} government={whatGovernmentCanDo} />

    <section>
      <div class="section-head"><h2>Solutions for this problem</h2><p>{solutions.length}</p></div>
      {solutions.length ? <div class="cards">{solutions.map((s) => <SolutionCard solution={s} />)}</div> : <p class="empty">No solutions added yet.</p>}
    </section>

    <ResourceSection resources={resources} />

    {related.length > 0 && (
      <section>
        <div class="section-head"><h2>Related problems</h2></div>
        <div class="cards">{related.map((p) => <ProblemCard problem={p} />)}</div>
      </section>
    )}
  </div>
</Base>

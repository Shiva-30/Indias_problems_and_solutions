---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProblemCard from '../components/ProblemCard.astro';
import SolutionCard from '../components/SolutionCard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { byTitle, plural } from '../lib/data';

const problems = (await getCollection('problems')).sort(byTitle);
const solutions = (await getCollection('solutions')).sort(byTitle);
const resources = await getCollection('resources');
const categories = await getCollection('categories');
const withStats = problems.filter((p) => p.data.keyStats.length > 0).slice(0, 6);
const steps = problems.reduce((n, p) => n + p.data.whatYouCanDo.length, 0);
const states = (await getCollection('regions')).filter((r) => r.data.type === 'state').length;
const count = (id: string, list: { data: { categories: { id: string }[] } }[]) =>
  list.filter((e) => e.data.categories.some((c) => c.id === id)).length;
const latest = <T extends { data: { updated: Date } }>(list: T[]) =>
  [...list].sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime()).slice(0, 3);
---
<Base title="Problem Atlas">
  <div class="stack">
    <section class="hero">
      <div>
        <h1>India's hardest problems, the evidence behind them, and what is working.</h1>
        <p class="lede">Every problem links to research, reports and videos, to the solutions being tried across the country, and to simple steps you can take yourself.</p>
        <form class="search" action="/search/" role="search">
          <input name="q" type="search" placeholder="Search problems, solutions, sources" aria-label="Search" />
          <button class="button" type="submit">Search</button>
        </form>
      </div>
      <div class="mosaic" aria-label="Categories">
        {categories.map((c) => (
          <a class={`c-${c.id}`} href={`/categories/${c.id}/`} title={c.data.name}>
            <CategoryIcon category={c.id} size={34} /><span>{c.data.name.split(' ')[0]}</span>
          </a>
        ))}
        <a class="c-none all-tile" href="/problems/"><b>{problems.length}</b><span>Problems</span></a>
        <a class="c-none all-tile" href="/solutions/"><b>{solutions.length}</b><span>Solutions</span></a>
      </div>
    </section>

    <section class="ledger-row" aria-label="Site contents">
      <div><b>{resources.length}</b><span>Sources</span></div>
      <div><b>{steps}</b><span>Steps you can take</span></div>
      <div><b>{states}</b><span>States covered</span></div>
    </section>

    <section>
      <div class="section-head"><h2>India in numbers</h2><p>Tap a figure to see the problem behind it</p></div>
      <div class="numbers">
        {withStats.map((p) => (
          <a class={`number c-${p.data.categories[0].id}`} href={`/problems/${p.id}/`}>
            <b>{p.data.keyStats[0].value}</b>
            <span>{p.data.keyStats[0].label}</span>
            <small>{p.data.title} · {p.data.keyStats[0].source}</small>
          </a>
        ))}
      </div>
    </section>

    <section>
      <div class="section-head"><h2>Browse by category</h2><p>Problems · solutions in each</p></div>
      <div class="cats">
        {categories.map((c) => (
          <a class={`cat c-${c.id}`} href={`/categories/${c.id}/`}>
            <span class="icon-chip"><CategoryIcon category={c.id} /></span>
            <strong>{c.data.name}</strong>
            <small>{plural(count(c.id, problems), 'problem')} · {plural(count(c.id, solutions), 'solution')}</small>
          </a>
        ))}
      </div>
    </section>

    <section>
      <div class="section-head"><h2>Problems</h2><a href="/problems/">See all {problems.length}</a></div>
      <div class="cards">{latest(problems).map((p) => <ProblemCard problem={p} />)}</div>
    </section>

    <section>
      <div class="section-head"><h2>Solutions that are working</h2><a href="/solutions/">See all {solutions.length}</a></div>
      <div class="cards">{latest(solutions).map((s) => <SolutionCard solution={s} />)}</div>
    </section>
  </div>
</Base>

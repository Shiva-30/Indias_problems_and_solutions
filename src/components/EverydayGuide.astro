---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CategoryIcon from './CategoryIcon.astro';
import { AREAS, IMPACTS } from '../lib/data';
import { AREAS_HI, IMPACTS_HI, T, hiValue, type Lang } from '../i18n/ui';
import habitsHi from '../i18n/hi/habits.json';

// One card per everyday habit of needless consumption. It questions the excess, not basic needs.
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const hi = lang === 'hi';
type Est = { change: string; person: string; household: string; society: string; method: string };
const tr = habitsHi as Record<string, { habit: string; fine: string; excess: string; figures: string[]; why: string[]; instead: string[]; estimate?: Est }>;

const habits = (await getCollection('habits'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((h) => {
    const x = hi ? tr[h.id] : undefined;
    return {
      id: h.id,
      area: h.data.area,
      impacts: h.data.impacts,
      habit: x?.habit ?? h.data.habit,
      fine: x?.fine ?? h.data.fine,
      excess: x?.excess ?? h.data.excess,
      figures: h.data.figures.map((f, i) => ({ ...f, value: hi ? hiValue(f.value) : f.value, label: x?.figures[i] ?? f.label })),
      why: h.data.why.map((w, i) => ({ ...w, text: x?.why[i] ?? w.text })),
      instead: x?.instead ?? h.data.instead,
      estimate: x?.estimate ?? h.data.estimate,
    };
  });
const areaLabels = hi ? AREAS_HI : AREAS;
const impactLabels = hi ? IMPACTS_HI : IMPACTS;
const areas = Object.keys(areaLabels).filter((a) => habits.some((h) => h.area === a));
const t = T[lang];

const text = {
  en: {
    title: 'Living with less',
    description: 'Everyday habits of needless consumption, what they cost the planet across their whole life cycle, and what to do instead.',
    summary: 'Much of what we buy and use has become normal, even when we could live comfortably with less. This guide lists everyday habits of needless consumption, what they cost the planet from start to finish, and what to do instead.',
    where: 'It questions the extra, not basic needs. One working phone is fine; a new phone every two years while the old one works is the question.',
    lifeTitle: 'Count the whole life cycle',
    life: [
      "For a mobile phone, mining materials and manufacturing cause about 74% of its lifetime CO₂, far more than charging it.",
      'For most foods, land use and farming cause more than 80% of the footprint, and transport less than 10%.',
      "So the biggest saving often comes from not buying or making something we don't need.",
      'Where a card shows what one change saves, it is a rough estimate worked out only from the sourced figures on that card, using global or UK averages unless it says India. Open "How we worked it out" to check the sum.',
    ],
    listTitle: 'Habits to question',
    count: (n: number) => `${n} habit${n === 1 ? '' : 's'}`,
    area: 'Area', impact: 'Impact', fine: 'Fine', question: 'Question',
    costs: 'What it costs', instead: 'Do this instead', noMatch: 'No habits match these filters.',
    saves: 'What one change saves', you: 'You', home: 'Your home', society: 'Society', how: 'How we worked it out',
    qTitle: 'Questions to ask before you buy or use', qSub: 'Five seconds that save resources',
    questions: [
      'Do I need it, or do I just want something new?',
      'Do I already have something that does the job?',
      'Can I repair, borrow, rent or buy it second-hand?',
      'How long will I use it, and what happens to it after?',
      'Is there a lower-impact way, such as walking, a fan or a home-cooked meal?',
    ],
    shareTitle: 'Share this guide',
    shareText: 'Living with less is not about going without what you need. It is about noticing what we use out of habit, advertising or status, and choosing better.',
    readMore: 'Read more in', readMoreLink: 'Excessive consumption',
  },
  hi: {
    title: 'कम में जीना',
    description: 'बेवजह की खपत की रोज़ की आदतें, पूरे जीवन-चक्र में धरती पर उनका असर, और उनकी जगह क्या करें।',
    summary: 'हम जो कुछ ख़रीदते और इस्तेमाल करते हैं, उसमें से बहुत कुछ आम हो गया है, जबकि हम कम में भी आराम से जी सकते हैं। यह गाइड बेवजह की खपत की रोज़ की आदतें बताती है, शुरू से आख़िर तक धरती पर उनका असर, और उनकी जगह क्या करें।',
    where: 'यह ज़रूरत पर नहीं, अतिरिक्त पर सवाल उठाती है। एक चलता हुआ फ़ोन ठीक है; पुराना ठीक चलते हुए भी हर दो साल में नया फ़ोन, यह सवाल है।',
    lifeTitle: 'पूरे जीवन-चक्र को गिनें',
    life: [
      'मोबाइल फ़ोन के जीवन भर के CO₂ का लगभग 74% खनिज निकालने और बनाने से आता है, चार्ज करने से कहीं ज़्यादा।',
      'ज़्यादातर खानों में असर का 80% से ज़्यादा ज़मीन के इस्तेमाल और खेती से आता है, और परिवहन से 10% से कम।',
      'इसलिए सबसे बड़ी बचत अक्सर वह चीज़ न ख़रीदने या न बनाने से होती है जिसकी हमें ज़रूरत नहीं।',
      'जहाँ कार्ड बताता है कि एक बदलाव से कितनी बचत होगी, वह उसी कार्ड के स्रोत वाले आँकड़ों से निकाला गया मोटा अनुमान है, जिसमें वैश्विक या ब्रिटेन के औसत हैं जब तक भारत न लिखा हो। हिसाब देखने के लिए "हमने कैसे निकाला" खोलें।',
    ],
    listTitle: 'सवाल उठाने लायक़ आदतें',
    count: (n: number) => `${n} आदतें`,
    area: 'क्षेत्र', impact: 'असर', fine: 'ठीक है', question: 'सवाल',
    costs: 'इसकी क़ीमत', instead: 'इसकी जगह यह करें', noMatch: 'इन फ़िल्टर से कोई आदत नहीं मिली।',
    saves: 'एक बदलाव से बचत', you: 'आप', home: 'आपका घर', society: 'समाज', how: 'हमने कैसे निकाला',
    qTitle: 'कुछ ख़रीदने या इस्तेमाल करने से पहले पूछें', qSub: 'पाँच सेकंड जो संसाधन बचाते हैं',
    questions: [
      'क्या मुझे इसकी ज़रूरत है, या बस कुछ नया चाहिए?',
      'क्या मेरे पास पहले से कुछ है जिससे काम चल जाए?',
      'क्या मैं इसकी मरम्मत करा सकता हूँ, उधार ले सकता हूँ, किराये पर ले सकता हूँ या पुराना ख़रीद सकता हूँ?',
      'मैं इसे कितने समय तक इस्तेमाल करूँगा, और उसके बाद इसका क्या होगा?',
      'क्या कम असर वाला कोई तरीक़ा है, जैसे पैदल चलना, पंखा या घर का खाना?',
    ],
    shareTitle: 'यह गाइड शेयर करें',
    shareText: 'कम में जीने का मतलब ज़रूरत की चीज़ों के बिना रहना नहीं है। इसका मतलब है यह देखना कि हम आदत, विज्ञापन या दिखावे के लिए क्या इस्तेमाल करते हैं, और बेहतर चुनना।',
    readMore: 'अंग्रेज़ी में और पढ़ें:', readMoreLink: 'Excessive consumption',
  },
}[lang];
const lifeSources = [
  { source: 'Journal of Industrial Ecology (2017)', url: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC13070977/' },
  { source: 'Our World in Data', url: 'https://ourworldindata.org/food-choice-vs-eating-local' },
];
---
<Base title={text.title} description={text.description} lang={lang}>
  <div class="stack">
    <header class="page-hero c-consumption">
      <div class="detail-head">
        <span class="tag kind-problem">{t.guide}</span>
        <h1>{text.title}</h1>
        <p class="summary">{text.summary}</p>
        <p class="where">{text.where}</p>
        {t.sourcesNote && <p class="lang-note">{t.sourcesNote}</p>}
      </div>
      <div class="hero-art"><CategoryIcon category="consumption" size={72} /></div>
    </header>

    <section class="principle">
      <h2>{text.lifeTitle}</h2>
      <ul>
        {text.life.map((l, i) => (
          <li>{l} {lifeSources[i] && <a class="src-link" href={lifeSources[i].url} target="_blank" rel="noopener" lang="en">{lifeSources[i].source}</a>}</li>
        ))}
      </ul>
    </section>

    <section>
      <div class="section-head"><h2>{text.listTitle}</h2><p id="hCount">{text.count(habits.length)}</p></div>
      <div class="filters">
        <label for="fArea">{text.area}
          <select id="fArea"><option value="">{t.all}</option>{areas.map((a) => <option value={a}>{areaLabels[a]}</option>)}</select>
        </label>
        <label for="fImpact">{text.impact}
          <select id="fImpact"><option value="">{t.all}</option>{Object.entries(impactLabels).map(([k, v]) => <option value={k}>{v}</option>)}</select>
        </label>
      </div>
      <div class="practices" id="habits" data-lang={lang}>
        {habits.map((h) => (
          <article class="practice" id={h.id} data-area={h.area} data-impacts={h.impacts.join(' ')}>
            <p class="area">{areaLabels[h.area]}</p>
            <h3>{h.habit}</h3>
            <div class="tags">{h.impacts.map((i) => <span class="tag harm">{impactLabels[i]}</span>)}</div>
            <dl class="need">
              <dt>{text.fine}</dt><dd>{h.fine}</dd>
              <dt>{text.question}</dt><dd>{h.excess}</dd>
            </dl>
            {h.figures.length > 0 && (
              <ul class="figures">
                {h.figures.map((f) => (
                  <li><strong>{f.value}</strong> <span>{f.label}</span> <a class="src-link" href={f.url} target="_blank" rel="noopener" lang="en">{f.source}</a></li>
                ))}
              </ul>
            )}
            <div class="why">
              <h4>{text.costs}</h4>
              <ul>{h.why.map((w) => <li>{w.text} <a class="src-link" href={w.url} target="_blank" rel="noopener" lang="en">{w.source}</a></li>)}</ul>
            </div>
            <div class="instead">
              <h4>{text.instead}</h4>
              <ul>{h.instead.map((i) => <li>{i}</li>)}</ul>
            </div>
            {h.estimate && (
              <div class="estimate">
                <h4>{text.saves}</h4>
                <p class="change">{h.estimate.change}</p>
                <dl>
                  <dt>{text.you}</dt><dd>{h.estimate.person}</dd>
                  <dt>{text.home}</dt><dd>{h.estimate.household}</dd>
                  <dt>{text.society}</dt><dd>{h.estimate.society}</dd>
                </dl>
                <details><summary>{text.how}</summary><p>{h.estimate.method}</p></details>
              </div>
            )}
          </article>
        ))}
      </div>
      <p class="empty" id="noMatch" hidden>{text.noMatch}</p>
    </section>

    <section class="checklist">
      <div class="section-head"><h2>{text.qTitle}</h2><p>{text.qSub}</p></div>
      <div class="q-grid">
        <div class="q-card">
          <ul>{text.questions.map((q) => <li>{q}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="principle">
      <h2>{text.shareTitle}</h2>
      <p>{text.shareText} {text.readMore} <a href="/problems/overconsumption/">{text.readMoreLink}</a>.</p>
      <p><button class="button" id="share" type="button" data-copied={t.copied}>{t.share}</button> <span id="shareMsg" aria-live="polite"></span></p>
    </section>
  </div>
</Base>

<script>
  const area = document.getElementById('fArea') as HTMLSelectElement;
  const impact = document.getElementById('fImpact') as HTMLSelectElement;
  const list = document.getElementById('habits')!;
  const cards = list.querySelectorAll<HTMLElement>('.practice');
  const count = document.getElementById('hCount')!;
  const noMatch = document.getElementById('noMatch')!;
  const hi = list.dataset.lang === 'hi';
  function apply() {
    let shown = 0;
    cards.forEach((c) => {
      const ok =
        (!area.value || c.dataset.area === area.value) &&
        (!impact.value || (c.dataset.impacts ?? '').split(' ').includes(impact.value));
      c.hidden = !ok;
      if (ok) shown++;
    });
    count.textContent = hi ? `${shown} आदतें` : `${shown} habit${shown === 1 ? '' : 's'}`;
    noMatch.hidden = shown > 0;
  }
  [area, impact].forEach((el) => el.addEventListener('input', apply));

  const share = document.getElementById('share')!;
  const msg = document.getElementById('shareMsg')!;
  share.addEventListener('click', async () => {
    const url = location.href.split('#')[0];
    try {
      if (navigator.share) await navigator.share({ title: document.title, url });
      else { await navigator.clipboard.writeText(url); msg.textContent = share.dataset.copied ?? ''; }
    } catch {}
  });
</script>

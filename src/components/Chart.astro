---
// A small bar or line chart drawn as SVG at build time. Colours come from the
// category tint (--c): the latest series is full strength, earlier ones lighter.
interface Row { label: string; values: number[] }
interface Props {
  title: string;
  kind: 'bar' | 'line';
  unit: string;
  series: string[];
  data: Row[];
  note?: string;
  source: string;
  sourceUrl: string;
}
const { title, kind, unit, series, data, note, source, sourceUrl } = Astro.props;

const W = 440, H = 240, left = 40, right = 8, top = 24, bottom = 34;
const plotW = W - left - right, plotH = H - top - bottom;
const nSeries = Math.max(1, ...data.map((d) => d.values.length));
const max = Math.max(...data.flatMap((d) => d.values));
// A round top for the axis: 1, 2 or 5 times a power of ten, in 4 steps.
const rawStep = max / 4;
const mag = 10 ** Math.floor(Math.log10(rawStep));
const step = [1, 2, 2.5, 5, 10].map((m) => m * mag).find((s) => s >= rawStep) ?? rawStep;
const yMax = step * Math.ceil(max / step);
const ticks = Array.from({ length: Math.round(yMax / step) + 1 }, (_, i) => i * step);
const y = (v: number) => top + plotH - (v / yMax) * plotH;
const num = (v: number) => v.toLocaleString('en-IN', { maximumFractionDigits: 2 });
const fmt = (v: number) => `${num(v)}${unit}`;
// Axis ticks carry the unit only when it is short, such as "%".
const tickFmt = (v: number) => (unit.trim().length <= 1 ? fmt(v) : num(v));
const seriesFill = (i: number) =>
  i === nSeries - 1 ? 'var(--c)' : `color-mix(in srgb, var(--c) ${Math.round(35 + (45 * i) / Math.max(1, nSeries - 1))}%, white)`;

const band = plotW / data.length;
const barGap = 2;
const groupW = Math.min(band * 0.72, nSeries * 48);
const barW = (groupW - barGap * (nSeries - 1)) / nSeries;
const xCenter = (i: number) => left + band * i + band / 2;
const linePath = data.map((d, i) => `${i ? 'L' : 'M'}${xCenter(i)} ${y(d.values[0])}`).join(' ');
const r = 4; // rounded data end
const barPath = (x: number, v: number) => {
  const yt = y(v), yb = y(0), rr = Math.min(r, (yb - yt) / 2, barW / 2);
  return `M${x} ${yb}V${yt + rr}Q${x} ${yt} ${x + rr} ${yt}H${x + barW - rr}Q${x + barW} ${yt} ${x + barW} ${yt + rr}V${yb}Z`;
};
---
<figure class="chart">
  <figcaption>
    <strong>{title}{unit.trim().length > 1 && ` (${unit.trim()})`}</strong>
    {series.length > 1 && (
      <span class="legend">
        {series.map((s, i) => <span><i style={`background:${seriesFill(i)}`}></i>{s}</span>)}
      </span>
    )}
  </figcaption>
  <div class="chart-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${title}. ${data.map((d) => `${d.label}: ${d.values.map(fmt).join(', ')}`).join('; ')}`}>
      {ticks.map((t) => (
        <g>
          <line x1={left} x2={W - right} y1={y(t)} y2={y(t)} class={t === 0 ? 'axis' : 'grid'} />
          <text x={left - 8} y={y(t) + 4} text-anchor="end" class="tick">{tickFmt(t)}</text>
        </g>
      ))}
      {data.map((d, i) => <text x={xCenter(i)} y={H - bottom + 22} text-anchor="middle" class="tick">{d.label}</text>)}
      {kind === 'bar' &&
        data.map((d, i) =>
          d.values.map((v, s) => {
            const x = xCenter(i) - groupW / 2 + s * (barW + barGap);
            return (
              <g class="mark">
                <path d={barPath(x, v)} fill={seriesFill(s)}><title>{`${d.label}${series[s] ? ` (${series[s]})` : ''}: ${fmt(v)}`}</title></path>
                <text x={x + barW / 2} y={y(v) - 6} text-anchor="middle" class="value">{tickFmt(v)}</text>
              </g>
            );
          }),
        )}
      {kind === 'line' && (
        <>
          <path d={linePath} fill="none" stroke="var(--c)" stroke-width="2" stroke-linejoin="round" />
          {data.map((d, i) => (
            <g class="mark">
              <circle cx={xCenter(i)} cy={y(d.values[0])} r="5" fill="var(--c)" stroke="var(--surface)" stroke-width="2"><title>{`${d.label}: ${fmt(d.values[0])}`}</title></circle>
              {(i === 0 || i === data.length - 1) && <text x={xCenter(i)} y={y(d.values[0]) - 12} text-anchor="middle" class="value">{tickFmt(d.values[0])}</text>}
            </g>
          ))}
        </>
      )}
    </svg>
  </div>
  <p class="chart-source">
    {note && <>{note}{' '}</>}Source: <a href={sourceUrl} target="_blank" rel="noopener">{source}</a>
  </p>
  <details class="chart-data">
    <summary>Show the numbers</summary>
    <table>
      <thead><tr><th></th>{(series.length ? series : ['Value']).map((s) => <th>{s}</th>)}</tr></thead>
      <tbody>{data.map((d) => <tr><th>{d.label}</th>{d.values.map((v) => <td>{fmt(v)}</td>)}</tr>)}</tbody>
    </table>
  </details>
</figure>
